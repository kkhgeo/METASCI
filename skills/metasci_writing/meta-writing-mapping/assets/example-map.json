  ],
  "paragraphs": [
    { "id": "P1", "section": "S1", "role": "Background", "topic_at": "P1-S1", "sentences": 3,
      "topic": "Nitrate contamination of alluvial aquifers threatens rural drinking water supplies.",
      "to_next": { "relation": "Continuation", "signal": "Previous studies have" } },
    { "id": "P2", "section": "S1", "role": "Literature-Review", "topic_at": "P2-S1", "sentences": 3,
      "topic": "Previous studies have used dual nitrate isotopes to separate fertilizer and manure sources.",
      "to_next": { "relation": "Contrast", "signal": "However," } },
    { "id": "P3", "section": "S1", "role": "Gap", "topic_at": "P3-S1", "sentences": 2,
      "topic": "However, denitrification overprints the source signal, and few studies have estimated source contributions and denitrification together.",
      "to_next": { "relation": "Problem-Solution", "signal": "To address this gap," } },
    { "id": "P4", "section": "S1", "role": "Purpose", "topic_at": "P4-S1", "sentences": 2,
      "topic": "To address this gap, we combined dual isotopes with a Bayesian mixing model to estimate source contributions and the extent of denitrification together." },
    { "id": "P5", "section": "S2", "role": "Study-Area", "topic_at": "P5-S1", "sentences": 3,
      "topic": "The study area is a riverside alluvial aquifer, where 42 wells were sampled twice.",
      "to_next": { "relation": "Sequence", "signal": "Nitrate isotopes were" } },
    { "id": "P6", "section": "S2", "role": "Procedure", "topic_at": "P6-S1", "sentences": 2,
      "topic": "Nitrate isotopes were analysed by the denitrifier method (Sigman et al., 2001).",
      "to_next": { "relation": "Sequence", "signal": "Source contributions were" } },
    { "id": "P7", "section": "S2", "role": "Statistical", "topic_at": "P7-S1", "sentences": 2,
      "topic": "Source contributions were estimated with MixSIAR, and denitrification with a Rayleigh model (Stock et al., 2018)." },
    { "id": "P8", "section": "S3", "role": "Finding", "topic_at": "P8-S1", "sentences": 2,
      "topic": "Nitrate concentrations increased from 3.1 mg/L upstream to 18.4 mg/L downstream.",
      "to_next": { "relation": "Continuation", "signal": "In a group of wells," } },
    { "id": "P9", "section": "S3", "role": "Pattern", "topic_at": "P9-S1", "sentences": 2,
      "topic": "In a group of wells, δ15N and δ18O increased together with a slope of about 1.3:1.",
      "to_next": { "relation": "Continuation", "signal": "The mixing model" } },
    { "id": "P10", "section": "S3", "role": "Finding", "topic_at": "P10-S1", "sentences": 2,
      "topic": "The mixing model placed the manure contribution highest, at 62%, in the downstream reach.",
      "to_next": { "relation": "none" } },
    { "id": "P11", "section": "S3", "role": "Anomaly", "topic_at": "P11-S1", "sentences": 2,
      "topic": "Several downstream wells combined low dissolved oxygen with low nitrate." },
    { "id": "P12", "section": "S4", "role": "Interpretation", "topic_at": "P12-S1", "sentences": 3,
      "topic": "The 1.3:1 slope cannot be explained by source mixing alone and points to ongoing denitrification.",
      "to_next": { "relation": "Continuation", "signal": "the same process" } },
    { "id": "P13", "section": "S4", "role": "Mechanism", "topic_at": "P13-S1", "sentences": 2,
      "topic": "The low nitrate in low-oxygen wells is explained by the same process.",
      "to_next": { "relation": "Continuation", "signal": "Recalculated as" } },
    { "id": "P14", "section": "S4", "role": "Lit-Comparison", "topic_at": "P14-S1", "sentences": 2,
      "topic": "Recalculated as a corrected contribution, the manure share falls to 48%, close to earlier reports.",
      "to_next": { "relation": "Concession", "signal": "is sensitive to" } },
    { "id": "P15", "section": "S4", "role": "Limitation", "topic_at": "P15-S1", "sentences": 2,
      "topic": "The corrected contribution is the mixing-model share after removing the denitrified fraction, and it is sensitive to the assumed enrichment factor.",
      "to_next": { "relation": "none" } },
    { "id": "P16", "section": "S4", "role": "Context", "topic_at": "P16-S1", "sentences": 2,
      "topic": "Rainfall and groundwater levels in the study area vary strongly with the seasons." },
    { "id": "P17", "section": "S5", "role": "Conclusion", "topic_at": "P17-S1", "sentences": 2,
      "topic": "Unless denitrification is separated, manure sources are overestimated, so both processes must be estimated together." }
  ],
